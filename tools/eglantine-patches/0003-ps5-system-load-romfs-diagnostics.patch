     file_ctx->parent = std::move(parent_dir_ctx);
@@ -194,7 +204,17 @@ RomFSBuildContext::RomFSBuildContext(VirtualDir base_, VirtualDir ext_)
     num_dirs = 1;
     dir_table_size = 0x18;
 
+#ifdef PS5_NATIVE
+    std::fputs("EDEN_LOOSE_ROMFS_SCAN begin\n", stderr);
+    std::fflush(stderr);
+#endif
     VisitDirectory(base, ext, root);
+#ifdef PS5_NATIVE
+    std::fprintf(stderr, "EDEN_LOOSE_ROMFS_SCAN done files=%llu dirs=%llu\n",
+                 static_cast<unsigned long long>(num_files),
