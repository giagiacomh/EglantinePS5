@@ -178,6 +179,15 @@ bool RomFSBuildContext::AddFile(std::shared_ptr<RomFSBuildDirectoryContext> pare
                                 std::shared_ptr<RomFSBuildFileContext> file_ctx) {
     // Add a new file.
     num_files++;
+#ifdef PS5_NATIVE
+    // Show progress during construction of very large extracted ROM filesystems.
+    if ((num_files & 8191u) == 0) {
+        std::fprintf(stderr, "EDEN_LOOSE_ROMFS_SCAN files=%llu dirs=%llu\n",
+                     static_cast<unsigned long long>(num_files),
+                     static_cast<unsigned long long>(num_dirs));
+        std::fflush(stderr);
+    }
+#endif
     file_table_size +=
