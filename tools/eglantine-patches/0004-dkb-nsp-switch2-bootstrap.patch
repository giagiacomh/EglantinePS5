+// Detect the program's Switch 2 NPDM *before* kernel initialization. Testing only
+// file->GetContainingDirectory() works for a loose ExeFS/main but not NSP/XCI/NCA:
+// the containing directory of a container is the host game-list folder.
+bool IsSwitch2ExeFS(const FileSys::VirtualDir& exefs) {
+    const auto npdm = exefs != nullptr ? exefs->GetFile("main.npdm") : nullptr;
     FileSys::ProgramMetadata metadata;
     return npdm != nullptr && metadata.Load(npdm) == Loader::ResultStatus::Success &&
            metadata.IsSwitch2();
 }
 
+bool IsSwitch2Nsp(const FileSys::NSP& nsp) {
+    if (nsp.GetStatus() != Loader::ResultStatus::Success) {
+        return false;
+    }
+    if (nsp.IsExtractedType()) {
+        return IsSwitch2ExeFS(nsp.GetExeFS());
+    }
+    const u64 title_id = nsp.GetProgramTitleID();
+    if (title_id == 0) {
+        return false;
+    }
+    const auto program = nsp.GetNCA(title_id, FileSys::ContentRecordType::Program);
+    return program != nullptr && program->GetStatus() == Loader::ResultStatus::Success &&
+           IsSwitch2ExeFS(program->GetExeFS());
+}
+
+bool IsSwitch2Program(const FileSys::VirtualFile& file, u64 program_id,
+                      std::size_t program_index) {
+    if (file == nullptr) {
+        return false;
+    }
+    if (IsSwitch2ExeFS(file->GetContainingDirectory())) {
+        return true;
+    }
+
+    switch (Loader::GuessFromFilename(file->GetName())) {
+    case Loader::FileType::NCA: {
+        FileSys::NCA nca{file};
+        return nca.GetStatus() == Loader::ResultStatus::Success &&
+               IsSwitch2ExeFS(nca.GetExeFS());
+    }
+    case Loader::FileType::NSP:
+    case Loader::FileType::NSZ: {
+        const FileSys::NSP nsp{file, program_id, program_index};
+        return IsSwitch2Nsp(nsp);
+    }
+    case Loader::FileType::XCI:
+    case Loader::FileType::XCZ: {
+        FileSys::XCI xci{file, program_id, program_index};
+        if (xci.GetStatus() == Loader::ResultStatus::Success) {
+            if (const auto partition = xci.GetSecurePartitionNSP()) {
+                return IsSwitch2Nsp(*partition);
+            }
+        }
+        // PFS0-shaped .xcz files are dispatched to the NSP loader.
+        if (Loader::GuessFromFilename(file->GetName()) == Loader::FileType::XCZ) {
+            const FileSys::NSP nsp{file, program_id, program_index};
+            return IsSwitch2Nsp(nsp);
+        }
+        return false;
+    }
+    default:
+        return false;
+    }
+}
+
 } // namespace
 
